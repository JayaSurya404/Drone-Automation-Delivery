{
  "name": "skynav-drone-platform",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "customer/backend",
    "customer/frontend",
    "admin/backend",
    "admin/frontend",
    "shared/contracts"
  ],
  "scripts": {
    "dev:customer:backend": "npm run dev --workspace=customer-backend",
    "dev:customer:frontend": "npm run dev --workspace=customer-frontend",
    "dev:customer": "concurrently -k -n \"CUST_API,CUST_WEB\" -c \"cyan,blue\" \"npm run dev:customer:backend\" \"npm run dev:customer:frontend\"",
    "dev:admin:backend": "npm run dev --workspace=admin-backend",
    "dev:admin:frontend": "npm run dev --workspace=skynav-admin-control-center",
    "dev:admin": "concurrently -k -n \"ADMIN_API,ADMIN_WEB\" -c \"magenta,yellow\" \"npm run dev:admin:backend\" \"npm run dev:admin:frontend\"",
    "dev:all": "concurrently -k -n \"CUST_API,CUST_WEB,ADMIN_API,ADMIN_WEB\" -c \"cyan,blue,magenta,yellow\" \"npm run dev:customer:backend\" \"npm run dev:customer:frontend\" \"npm run dev:admin:backend\" \"npm run dev:admin:frontend\"",
    "seed:customer": "npm run seed --workspace=customer-backend",
    "seed:admin": "npm run seed --workspace=admin-backend",
    "seed:all": "npm run seed:customer && npm run seed:admin",
    "build": "npm run build --workspaces"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
