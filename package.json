{
  "name": "skynav",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "test:e2e": "playwright test",
    "db:generate": "turbo run db:generate --filter=@skynav/api",
    "db:migrate": "turbo run db:migrate --filter=@skynav/api",
    "db:migrate:deploy": "turbo run db:migrate:deploy --filter=@skynav/api",
    "db:seed": "turbo run db:seed --filter=@skynav/api",
    "clean": "turbo run clean",
    "dev:legacy": "concurrently -k \"pnpm --filter=@skynav/legacy-customer-backend dev\" \"pnpm --filter=@skynav/legacy-admin-backend dev\"",
    "seed:legacy": "pnpm --filter=@skynav/legacy-customer-backend seed && pnpm --filter=@skynav/legacy-admin-backend seed"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "concurrently": "^9.1.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
