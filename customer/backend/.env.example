# ── SUPABASE CONFIGURATION ──
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ── APPLICATION SERVER ──
PORT=5000
NODE_ENV=development
JWT_SECRET=your_secure_jwt_secret_key_here
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173
DATABASE_URL=data/skynav.db

# ── SMTP EMAIL SERVICE CONFIGURATION (Nodemailer) ──
# Provide credentials from your SMTP provider (Gmail, Brevo, SendGrid, Amazon SES, or custom SMTP)
# If left empty in development, SkyNav automatically initializes a live Ethereal test inbox.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username_or_email
SMTP_PASSWORD=your_smtp_app_password_here
SMTP_FROM="SkyNav Aero Store <no-reply@yourdomain.com>"

# ── SHARED SECRETS & INTEGRATION ──
INTEGRATION_SECRET=your_hmac_shared_secret_here
ADMIN_BACKEND_URL=http://localhost:5001
CUSTOMER_BACKEND_URL=http://localhost:5000
