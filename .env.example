# ==============================================================================
# SkyNav Platform - Safe Development Environment Variables Template
# Copy this file to .env for local development:
#   Copy-Item .env.example .env (PowerShell)
#   cp .env.example .env (Bash)
# ==============================================================================

# Node Environment ('development' | 'test' | 'production')
NODE_ENV=development

# Fastify API Server Configuration
API_PORT=3001
API_HOST=0.0.0.0
API_CORS_ORIGIN=http://localhost:3000

# PostgreSQL + PostGIS Database Connection
DATABASE_URL=postgresql://skynav:skynav@localhost:5432/skynav

# Redis (Pub/Sub, Caching, Streams) Connection
REDIS_URL=redis://localhost:6379

# Authentication & Security
# WARNING: In production, generate a secure random 256-bit string.
JWT_SECRET=skynav-development-jwt-secret-key-32chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Advisory AI Service
AI_SERVICE_URL=http://localhost:8000
