# SkyNav Autonomous Drone Delivery Platform — Monorepo Configuration (.env)
# Copy this file to .env and configure strong values. Startup fails if secrets are unset.

# ── POSTGRESQL + POSTGIS (docker-compose: postgres) ──
POSTGRES_USER=skynav_admin
POSTGRES_PASSWORD=your_strong_postgres_password_here
POSTGRES_DB=skynav_delivery
POSTGRES_PORT=5432
DATABASE_URL=postgresql://skynav_admin:your_strong_postgres_password_here@localhost:5432/skynav_delivery?schema=public

# ── REDIS (docker-compose: redis) ──
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ── MINIO S3-COMPATIBLE OBJECT STORAGE (docker-compose: minio) ──
MINIO_IMAGE=quay.io/thanos/minio:RELEASE.2025-09-07T16-13-09Z
MINIO_ROOT_USER=skynav_storage_admin
MINIO_ROOT_PASSWORD=your_strong_minio_password_here
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
STORAGE_ENDPOINT=localhost
STORAGE_PORT=9000
STORAGE_USE_SSL=false
STORAGE_ACCESS_KEY=skynav_storage_admin
STORAGE_SECRET_KEY=your_strong_minio_password_here
STORAGE_BUCKET=skynav-delivery-local
STORAGE_REGION=ap-south-1

# ── MAILHOG (SMTP testing inbox, docker-compose: mailhog) ──
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM="SkyNav Aero Delivery <no-reply@skynav.local>"

# ── APPS / API (NestJS backend :4000) ──
PORT=4000
NODE_ENV=development
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174
ENABLE_SWAGGER=true

# ── AUTHENTICATION & SECURITY ──
# Flaw (a) fixed: Dedicated cookie names & paths prevent admin login from logging out customer on localhost.
JWT_ACCESS_SECRET=your_32_character_jwt_access_secret_key_here
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
CUSTOMER_REFRESH_COOKIE_NAME=skynav_customer_refresh_token
ADMIN_REFRESH_COOKIE_NAME=skynav_admin_refresh_token
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=30
SKYNAV_INTERNAL_SERVICE_KEY=your_32_character_hmac_service_key_here

# ── SEED ACCOUNTS & HUB LOCATION (SkyHub Kurumbapalayam, Coimbatore) ──
BOOTSTRAP_SUPER_ADMIN_EMAIL=admin@skynav.local
BOOTSTRAP_SUPER_ADMIN_PASSWORD=your_strong_admin_password_here
CUSTOMER_SEED_EMAIL=customer@skynav.local
CUSTOMER_SEED_PASSWORD=your_strong_customer_password_here
DEFAULT_HUB_NAME="SkyHub Kurumbapalayam"
DEFAULT_HUB_LATITUDE=11.1132
DEFAULT_HUB_LONGITUDE=77.0277

# ── GAZEBO SIMULATION TELEMETRY BRIDGE ──
GAZEBO_BRIDGE_PORT=8085
GAZEBO_BRIDGE_URL=http://localhost:8085

# ── LEGACY BACKENDS (during migration) ──
LEGACY_CUSTOMER_API=http://localhost:5000
LEGACY_ADMIN_API=http://localhost:5001
ADMIN_SEED_PASSWORD=your_strong_legacy_admin_password
CUSTOMER_SEED_PASSWORD=your_strong_legacy_customer_password
ADMIN_PORT=5001
ADMIN_JWT_SECRET=your_32_character_admin_jwt_secret_here
JWT_SECRET=your_32_character_customer_jwt_secret_here
