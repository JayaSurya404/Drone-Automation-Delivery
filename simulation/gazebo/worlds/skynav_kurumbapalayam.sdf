              <length>0.1</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.1 0.6 0.3 1</ambient>
            <diffuse>0.15 0.8 0.4 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Secondary Customer Destination Drop Pad (Kalapatti South Drop Zone: 4.71 km) -->
    <model name="customer_kalapatti_drop_pad">
