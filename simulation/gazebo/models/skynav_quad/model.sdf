<?xml version="1.0" ?>
<sdf version="1.8">
  <model name="skynav_quad">
    <pose>0 0 0.15 0 0 0</pose>
    <static>false</static>

    <!-- Main Airframe Fuselage Link -->
    <link name="base_link">
      <inertial>
        <mass>2.45</mass>
        <inertia>
          <ixx>0.0347563</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.0458929</iyy>
          <iyz>0</iyz>
          <izz>0.05887</izz>
        </inertia>
      </inertial>

      <collision name="fuselage_col">
        <geometry>
          <box>
            <size>0.45 0.45 0.18</size>
          </box>
        </geometry>
      </collision>

      <visual name="fuselage_vis">
        <geometry>
          <box>
            <size>0.45 0.45 0.18</size>
          </box>
        </geometry>
        <material>
          <ambient>0.05 0.08 0.12 1.0</ambient>
          <diffuse>0.1 0.15 0.22 1.0</diffuse>
        </material>
      </visual>

      <!-- Carbon Fiber Arm Visuals -->
      <visual name="arm_front_right">
        <pose>0.16 0.16 0 0 0 0.785</pose>
        <geometry>
          <cylinder>
            <radius>0.015</radius>
            <length>0.28</length>
          </cylinder>
        </geometry>
      </visual>

      <visual name="arm_front_left">
        <pose>-0.16 0.16 0 0 0 -0.785</pose>
        <geometry>
          <cylinder>
            <radius>0.015</radius>
            <length>0.28</length>
          </cylinder>
        </geometry>
      </visual>

      <visual name="arm_back_left">
        <pose>-0.16 -0.16 0 0 0 0.785</pose>
        <geometry>
          <cylinder>
            <radius>0.015</radius>
            <length>0.28</length>
          </cylinder>
        </geometry>
      </visual>

      <visual name="arm_back_right">
        <pose>0.16 -0.16 0 0 0 -0.785</pose>
        <geometry>
          <cylinder>
            <radius>0.015</radius>
            <length>0.28</length>
          </cylinder>
        </geometry>
      </visual>

      <!-- Sensor: 6-Axis IMU Sensor -->
      <sensor name="imu_sensor" type="imu">
        <always_on>1</always_on>
        <update_rate>250</update_rate>
        <topic>/skynav/sensors/imu</topic>
        <imu>
          <angular_velocity>
            <x><noise type="gaussian"><mean>0.0</mean><stddev>0.0002</stddev></noise></x>
            <y><noise type="gaussian"><mean>0.0</mean><stddev>0.0002</stddev></noise></y>
            <z><noise type="gaussian"><mean>0.0</mean><stddev>0.0002</stddev></noise></z>
          </angular_velocity>
          <linear_acceleration>
            <x><noise type="gaussian"><mean>0.0</mean><stddev>0.017</stddev></noise></x>
            <y><noise type="gaussian"><mean>0.0</mean><stddev>0.017</stddev></noise></y>
            <z><noise type="gaussian"><mean>0.0</mean><stddev>0.017</stddev></noise></z>
          </linear_acceleration>
        </imu>
      </sensor>

      <!-- Sensor: Navigational RTK-GPS Sensor -->
      <sensor name="nav_gps" type="navsat">
        <always_on>1</always_on>
        <update_rate>10</update_rate>
        <topic>/skynav/sensors/gps</topic>
      </sensor>

      <!-- Sensor: Downward LiDAR Altimeter (0 - 50m AGL for landing) -->
      <sensor name="downward_lidar" type="altimeter">
        <always_on>1</always_on>
        <update_rate>50</update_rate>
        <topic>/skynav/sensors/lidar_alt</topic>
        <altimeter>
          <vertical_position>
            <noise type="gaussian"><mean>0.0</mean><stddev>0.01</stddev></noise>
          </vertical_position>
          <vertical_velocity>
            <noise type="gaussian"><mean>0.0</mean><stddev>0.01</stddev></noise>
          </vertical_velocity>
        </altimeter>
      </sensor>

      <!-- Sensor: Forward Horizontal Obstacle LiDAR (20Hz, 90 deg FOV, 60m range) -->
      <sensor name="forward_obstacle_lidar" type="gpu_lidar">
        <pose>0.18 0 0.05 0 0 0</pose>
        <always_on>1</always_on>
        <update_rate>20</update_rate>
        <ray>
          <scan>
            <horizontal>
              <samples>180</samples>
              <resolution>1</resolution>
              <min_angle>-0.785398</min_angle>
              <max_angle>0.785398</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.2</min>
            <max>60.0</max>
            <resolution>0.05</resolution>
          </range>
        </ray>
        <topic>/skynav/sensors/lidar_obstacle</topic>
      </sensor>
    </link>

    <!-- Rotor 1 (Front Right - CCW) -->
    <link name="rotor_0">
      <pose>0.22 0.22 0.08 0 0 0</pose>
      <inertial>
        <mass>0.025</mass>
        <inertia><ixx>9.75e-06</ixx><iyy>0.0001667</iyy><izz>0.000176</izz></inertia>
      </inertial>
      <visual name="rotor_0_vis">
        <geometry><cylinder><radius>0.15</radius><length>0.008</length></cylinder></geometry>
        <material><ambient>0 0.8 1 0.7</ambient><diffuse>0 0.8 1 0.7</diffuse></material>
      </visual>
    </link>
    <joint name="rotor_0_joint" type="revolute">
      <parent>base_link</parent>
      <child>rotor_0</child>
      <axis><xyz>0 0 1</xyz></axis>
    </joint>

    <!-- Rotor 2 (Front Left - CW) -->
    <link name="rotor_1">
      <pose>-0.22 0.22 0.08 0 0 0</pose>
      <inertial>
        <mass>0.025</mass>
        <inertia><ixx>9.75e-06</ixx><iyy>0.0001667</iyy><izz>0.000176</izz></inertia>
      </inertial>
      <visual name="rotor_1_vis">
        <geometry><cylinder><radius>0.15</radius><length>0.008</length></cylinder></geometry>
        <material><ambient>0 0.8 1 0.7</ambient><diffuse>0 0.8 1 0.7</diffuse></material>
      </visual>
    </link>
    <joint name="rotor_1_joint" type="revolute">
      <parent>base_link</parent>
      <child>rotor_1</child>
      <axis><xyz>0 0 1</xyz></axis>
    </joint>

    <!-- Rotor 3 (Back Left - CCW) -->
    <link name="rotor_2">
      <pose>-0.22 -0.22 0.08 0 0 0</pose>
      <inertial>
        <mass>0.025</mass>
        <inertia><ixx>9.75e-06</ixx><iyy>0.0001667</iyy><izz>0.000176</izz></inertia>
      </inertial>
      <visual name="rotor_2_vis">
        <geometry><cylinder><radius>0.15</radius><length>0.008</length></cylinder></geometry>
        <material><ambient>0.2 0.2 0.2 0.7</ambient><diffuse>0.3 0.3 0.3 0.7</diffuse></material>
      </visual>
    </link>
    <joint name="rotor_2_joint" type="revolute">
      <parent>base_link</parent>
      <child>rotor_2</child>
      <axis><xyz>0 0 1</xyz></axis>
    </joint>

    <!-- Rotor 4 (Back Right - CW) -->
    <link name="rotor_3">
      <pose>0.22 -0.22 0.08 0 0 0</pose>
      <inertial>
        <mass>0.025</mass>
        <inertia><ixx>9.75e-06</ixx><iyy>0.0001667</iyy><izz>0.000176</izz></inertia>
      </inertial>
      <visual name="rotor_3_vis">
        <geometry><cylinder><radius>0.15</radius><length>0.008</length></cylinder></geometry>
        <material><ambient>0.2 0.2 0.2 0.7</ambient><diffuse>0.3 0.3 0.3 0.7</diffuse></material>
      </visual>
    </link>
    <joint name="rotor_3_joint" type="revolute">
      <parent>base_link</parent>
      <child>rotor_3</child>
      <axis><xyz>0 0 1</xyz></axis>
    </joint>

    <!-- Multicopter Motor Dynamics Plugins (4 Rotors) -->
    <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel">
      <robotNamespace>/skynav</robotNamespace>
      <jointName>rotor_0_joint</jointName>
      <linkName>rotor_0</linkName>
      <turningDirection>ccw</turningDirection>
      <actuator_number>0</actuator_number>
      <motorConstant>8.54858e-06</motorConstant>
      <momentConstant>0.06</momentConstant>
      <maxRotVelocity>1100</maxRotVelocity>
      <rotorDragCoefficient>8.06428e-05</rotorDragCoefficient>
      <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
      <motorType>velocity</motorType>
    </plugin>

    <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel">
      <robotNamespace>/skynav</robotNamespace>
      <jointName>rotor_1_joint</jointName>
      <linkName>rotor_1</linkName>
      <turningDirection>cw</turningDirection>
      <actuator_number>1</actuator_number>
      <motorConstant>8.54858e-06</motorConstant>
      <momentConstant>0.06</momentConstant>
      <maxRotVelocity>1100</maxRotVelocity>
      <rotorDragCoefficient>8.06428e-05</rotorDragCoefficient>
      <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
      <motorType>velocity</motorType>
    </plugin>

    <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel">
      <robotNamespace>/skynav</robotNamespace>
      <jointName>rotor_2_joint</jointName>
      <linkName>rotor_2</linkName>
      <turningDirection>ccw</turningDirection>
      <actuator_number>2</actuator_number>
      <motorConstant>8.54858e-06</motorConstant>
      <momentConstant>0.06</momentConstant>
      <maxRotVelocity>1100</maxRotVelocity>
      <rotorDragCoefficient>8.06428e-05</rotorDragCoefficient>
      <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
      <motorType>velocity</motorType>
    </plugin>

    <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel">
      <robotNamespace>/skynav</robotNamespace>
      <jointName>rotor_3_joint</jointName>
      <linkName>rotor_3</linkName>
      <turningDirection>cw</turningDirection>
      <actuator_number>3</actuator_number>
      <motorConstant>8.54858e-06</motorConstant>
      <momentConstant>0.06</momentConstant>
      <maxRotVelocity>1100</maxRotVelocity>
      <rotorDragCoefficient>8.06428e-05</rotorDragCoefficient>
      <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
      <motorType>velocity</motorType>
    </plugin>

    <!-- Odometry Publisher Plugin -->
    <plugin
      filename="gz-sim-odometry-publisher-system"
      name="gz::sim::systems::OdometryPublisher">
      <dimensions>3</dimensions>
      <odom_frame>odom</odom_frame>
      <robot_base_frame>skynav_quad/base_link</robot_base_frame>
      <odom_topic>/skynav/odometry</odom_topic>
    </plugin>

    <!-- Multicopter Flight Dynamics Velocity Control Plugin -->
    <plugin
      filename="gz-sim-multicopter-control-system"
      name="gz::sim::systems::MulticopterVelocityControl">
      <robotNamespace>skynav</robotNamespace>
      <commandSubTopic>cmd_vel</commandSubTopic>
      <enableSubTopic>enable</enableSubTopic>
      <comLinkName>base_link</comLinkName>
      <velocityGain>2.7 2.7 2.7</velocityGain>
      <attitudeGain>2.0 2.0 2.0</attitudeGain>
      <angularRateGain>0.4 0.4 0.4</angularRateGain>
      <maximumLinearAcceleration>3.0 3.0 3.0</maximumLinearAcceleration>
      <rotorConfiguration>
        <rotor>
          <jointName>rotor_0_joint</jointName>
          <forceConstant>8.54858e-06</forceConstant>
          <momentConstant>0.06</momentConstant>
          <direction>1</direction>
        </rotor>
        <rotor>
          <jointName>rotor_1_joint</jointName>
          <forceConstant>8.54858e-06</forceConstant>
          <momentConstant>0.06</momentConstant>
          <direction>-1</direction>
        </rotor>
        <rotor>
          <jointName>rotor_2_joint</jointName>
          <forceConstant>8.54858e-06</forceConstant>
          <momentConstant>0.06</momentConstant>
          <direction>1</direction>
        </rotor>
        <rotor>
          <jointName>rotor_3_joint</jointName>
          <forceConstant>8.54858e-06</forceConstant>
          <momentConstant>0.06</momentConstant>
          <direction>-1</direction>
        </rotor>
      </rotorConfiguration>
    </plugin>

  </model>
</sdf>
